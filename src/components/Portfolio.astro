---
import { tFor } from '../i18n';

const t = tFor(Astro.currentLocale);

const gallery = [
  { slug: 'portrait-morning-light', category: 'portrait', kind: 'normal' },
  { slug: 'editorial-vogue-italia', category: 'projects', kind: 'tall' },
  { slug: 'landscape-silent-valley', category: 'diaries', kind: 'normal' },
  { slug: 'portrait-still-waters', category: 'portrait', kind: 'normal' },
  { slug: 'fineart-vanishing-point', category: 'nude', kind: 'wide' },
  { slug: 'editorial-kinfolk-magazine', category: 'projects', kind: 'normal' },
  { slug: 'landscape-suspended', category: 'diaries', kind: 'tall' },
  { slug: 'portrait-gold-hour', category: 'portrait', kind: 'normal' },
  { slug: 'fineart-ethereal', category: 'nude', kind: 'normal' },
  { slug: 'editorial-harpers-bazaar', category: 'projects', kind: 'wide' },
  { slug: 'landscape-dusk-field', category: 'diaries', kind: 'normal' },
  { slug: 'portrait-in-repose', category: 'portrait', kind: 'normal' },
];

const titles: Record<string, string> = t.portfolio.gallery;
const kinds: Record<string, string> = t.portfolio.kinds;

const items = gallery.map((item) => ({ ...item, title: titles[item.slug] }));

const categories = Object.entries(t.portfolio.categories).map(([key, label]) => ({ key, label }));

const kindClass = {
  normal: '',
  wide: 'col-span-2 max-[480px]:col-span-1',
  tall: 'row-span-2',
};
---

<section id="portfolio" class="px-gutter py-section">
  <div class="mx-auto max-w-page">
    <p class="section-label">{t.portfolio.label}</p>
    <h2 class="portfolio-heading mb-12 font-display text-h2 font-light">
      {t.portfolio.heading}
    </h2>

    <div class="mb-12 flex flex-wrap gap-2">
      {
        categories.map((cat, i) => (
          <button
            class:list={['filter-btn', 'cursor-pointer border border-parchment/15 px-[1.4rem] py-[0.6rem] text-[0.8rem] font-light tracking-[0.06em] text-stone transition-all duration-400 ease-ref hover:border-stone hover:text-paper', { active: i === 0 }]}
            data-filter={cat.key}
            type="button"
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <div
      class="grid grid-flow-dense grid-cols-3 gap-4 auto-rows-65 max-[768px]:grid-cols-2 max-[768px]:auto-rows-55 max-[480px]:grid-cols-1 max-[480px]:auto-rows-70"
    >
      {
        items.map((item) => (
          <div
            class:list={['gallery-item group relative cursor-pointer overflow-hidden', kindClass[item.kind]]}
            data-category={item.category}
            data-full={`/images/gallery/${item.slug}-1400.jpg`}
            data-caption={item.title}
          >
            <img
              src={`/images/gallery/${item.slug}-600.jpg`}
              srcset={`/images/gallery/${item.slug}-600.jpg 600w, /images/gallery/${item.slug}-1400.jpg 1400w`}
              sizes={
                item.kind === 'wide'
                  ? '(min-width:1024px) 66vw, (min-width:768px) 100vw, 100vw'
                  : '(min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw'
              }
              alt={`${kinds[item.category]} — ${item.title}`}
              loading="lazy"
              class="h-full w-full object-cover transition-[scale,filter] duration-600 ease-ref group-hover:scale-106 group-hover:brightness-70"
            />
            <div
              class="absolute inset-x-0 bottom-0 translate-y-2 bg-linear-to-t from-midnight/80 to-transparent p-6 opacity-0 transition-all duration-400 group-hover:translate-y-0 group-hover:opacity-100"
            >
              <span class="font-display text-[1.1rem] font-normal tracking-[0.02em]">
                {item.title}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<div
  id="lightbox"
  class="lightbox fixed inset-0 z-200 flex items-center justify-center bg-midnight/96"
  role="dialog"
  aria-label={t.portfolio.lightbox.label}
  aria-hidden="true"
>
  <button
    id="lightboxClose"
    class="absolute top-6 right-6 z-201 flex h-12 w-12 cursor-pointer items-center justify-center text-[2rem] leading-none text-stone transition-colors duration-400 ease-ref hover:text-paper"
    aria-label={t.portfolio.lightbox.close}>&times;</button
  >
  <button
    id="lightboxPrev"
    class="absolute left-6 top-1/2 z-201 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center text-stone transition-colors duration-400 ease-ref hover:text-paper"
    aria-label={t.portfolio.lightbox.prev}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button
    id="lightboxNext"
    class="absolute right-6 top-1/2 z-201 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center text-stone transition-colors duration-400 ease-ref hover:text-paper"
    aria-label={t.portfolio.lightbox.next}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
      <polyline points="9 6 15 12 9 18"></polyline>
    </svg>
  </button>
  <div class="flex max-h-[85vh] max-w-[85vw] flex-col items-center">
    <img src="" alt="" id="lightboxImg" class="max-h-[78vh] max-w-full object-contain" />
    <p id="lightboxCaption" class="mt-4 font-display text-base tracking-[0.02em] text-stone"></p>
  </div>
</div>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const galleryItems = Array.from(document.querySelectorAll<HTMLElement>('.gallery-item'));

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter;
      galleryItems.forEach((item) => {
        item.classList.toggle('hidden', filter !== 'all' && item.dataset.category !== filter);
      });
    });
  });

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightboxCaption');
  const lightboxClose = document.getElementById('lightboxClose');
  const lightboxPrev = document.getElementById('lightboxPrev');
  const lightboxNext = document.getElementById('lightboxNext');

  if (lightbox && lightboxImg && lightboxCaption && lightboxClose && lightboxPrev && lightboxNext) {
    let currentIndex = 0;
    let visibleItems: HTMLElement[] = [];

    const getVisibleItems = () => {
      visibleItems = galleryItems.filter((item) => !item.classList.contains('hidden'));
    };

    const updateLightboxContent = () => {
      const item = visibleItems[currentIndex];
      if (!item) return;
      const img = item.querySelector('img');
      lightboxImg.src = item.dataset.full ?? '';
      lightboxImg.alt = img ? img.alt : '';
      lightboxCaption.textContent = item.dataset.caption ?? '';
    };

    const openLightbox = (index: number) => {
      getVisibleItems();
      currentIndex = index;
      updateLightboxContent();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    const nextImage = () => {
      currentIndex = (currentIndex + 1) % visibleItems.length;
      updateLightboxContent();
    };

    const prevImage = () => {
      currentIndex = (currentIndex - 1 + visibleItems.length) % visibleItems.length;
      updateLightboxContent();
    };

    galleryItems.forEach((item) => {
      item.addEventListener('click', () => {
        getVisibleItems();
        const visibleIndex = visibleItems.indexOf(item);
        if (visibleIndex !== -1) openLightbox(visibleIndex);
      });
    });

    lightboxClose.addEventListener('click', closeLightbox);
    lightboxNext.addEventListener('click', nextImage);
    lightboxPrev.addEventListener('click', prevImage);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    });
  }
</script>
