---
import { locales, pathFor, resolveLocale, tFor, type Locale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = tFor(locale);

const links = [
  { id: 'about', href: '#about' },
  { id: 'services', href: '#services' },
  { id: 'portfolio', href: '#portfolio' },
  { id: 'contact', href: '#contact' },
] as const;

const codes: Record<Locale, string> = { uk: 'UA', en: 'EN' };

const languages = locales.map((l) => ({
  locale: l,
  code: codes[l],
  href: pathFor(l),
  label: t.nav.switcher[l],
  active: l === locale,
}));

const linkClass =
  'relative text-[0.85rem] font-light tracking-[0.04em] text-paper transition-colors duration-400 ease-ref after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-champagne after:transition-all after:duration-400 hover:text-champagne hover:after:w-full max-md:text-[1.1rem]';
---

<nav
  id="nav"
  class="fixed inset-x-0 top-0 z-100 flex items-center justify-between px-gutter py-6 transition-all duration-400 ease-ref"
>
  <a href="#" class="font-display text-2xl font-normal tracking-[0.02em] text-paper"
    >{t.nav.brand}</a
  >

  <button
    id="navToggle"
    class="nav-toggle z-101 hidden cursor-pointer flex-col gap-1.25 p-1 max-md:flex"
    aria-label={t.nav.menuToggle}
    aria-expanded="false"
  >
    <span class="block h-[1.5px] w-6 bg-paper transition-transform duration-300"></span>
    <span class="block h-[1.5px] w-6 bg-paper transition-transform duration-300"></span>
  </button>

  <ul
    id="navLinks"
    class="nav-links flex list-none gap-10 max-md:fixed max-md:top-0 max-md:right-0 max-md:z-100 max-md:h-screen max-md:w-[min(320px,80vw)] max-md:translate-x-full max-md:flex-col max-md:gap-6 max-md:bg-midnight/97 max-md:py-20 max-md:px-10 max-md:backdrop-blur-lg max-md:transition-transform max-md:duration-400 max-md:ease-ref"
  >
    {
      links.map((link) => (
        <li>
          <a href={link.href} class={linkClass}>
            {t.nav.links[link.id]}
          </a>
        </li>
      ))
    }
    <li class="text-[0.85rem] font-light tracking-[0.04em] max-md:text-[1.1rem]">
      <div
        role="group"
        aria-label={t.nav.switcher.aria}
        class="flex list-none items-center gap-2.5"
      >
        {
          languages.map((lang, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true" class="text-paper/25">
                  /
                </span>
              )}
              {lang.active ? (
                <span aria-current="true" lang={lang.locale} class="text-champagne">
                  {lang.code}
                  <span class="sr-only"> — {lang.label}</span>
                </span>
              ) : (
                <a
                  href={lang.href}
                  hreflang={lang.locale}
                  lang={lang.locale}
                  aria-label={lang.label}
                  class="text-paper/55 transition-colors duration-400 ease-ref hover:text-champagne"
                >
                  {lang.code}
                </a>
              )}
            </>
          ))
        }
      </div>
    </li>
  </ul>
</nav>

<script>
  const nav = document.getElementById('nav');
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');

  if (nav && navToggle && navLinks) {
    const handleScroll = () => nav.classList.toggle('nav-scrolled', window.scrollY > 60);
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    navToggle.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      navToggle.classList.toggle('active', open);
      navToggle.setAttribute('aria-expanded', String(open));
    });

    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('open');
        navToggle.classList.remove('active');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
