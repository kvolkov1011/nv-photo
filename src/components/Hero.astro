---
import { tFor } from '../i18n';

const t = tFor(Astro.currentLocale);
---

<header
  id="hero"
  class="relative flex h-screen min-h-150 items-end overflow-hidden px-gutter pb-24 max-md:items-center max-md:pb-16"
>
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero.jpg"
      alt=""
      aria-hidden="true"
      class="h-full w-full object-cover animate-hero-zoom"
    />
  </div>
  <div class="hero-overlay absolute inset-0 z-1"></div>

  <div class="relative z-2 max-w-180">
    <p
      class="mb-6 text-xs font-normal tracking-[0.2em] text-champagne uppercase opacity-0 translate-y-5 animate-fade-up [animation-delay:300ms]"
    >
      {t.hero.eyebrow}
    </p>
    <h1
      class="mb-6 font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.15] font-light tracking-[-0.01em] text-paper opacity-0 translate-y-7.5 animate-fade-up [animation-delay:500ms]"
      set:html={t.hero.headline}
    />
    <p
      class="mb-9 max-w-[44ch] text-[0.95rem] leading-[1.7] font-light text-parchment/85 opacity-0 translate-y-5 animate-fade-up [animation-delay:650ms]"
    >
      {t.hero.subline}
    </p>
    <div class="flex flex-wrap items-center gap-4">
      <a
        href="#portfolio"
        class="inline-block bg-champagne px-10 py-4 text-[0.8rem] font-normal tracking-[0.12em] text-midnight uppercase transition-all duration-400 ease-ref hover:-translate-y-0.5 hover:bg-paper opacity-0 translate-y-5 animate-fade-up [animation-delay:800ms]"
      >
        {t.hero.cta}
      </a>
      <a
        href="#contact"
        class="inline-block border border-paper/40 px-10 py-4 text-[0.8rem] font-normal tracking-[0.12em] text-paper uppercase transition-all duration-400 ease-ref hover:-translate-y-0.5 hover:border-champagne hover:text-champagne opacity-0 translate-y-5 animate-fade-up [animation-delay:950ms]"
      >
        {t.hero.ctaSecondary}
      </a>
    </div>
  </div>

  <div
    class="absolute right-gutter bottom-8 z-2 flex flex-col items-center gap-3 opacity-0 translate-y-5 animate-fade-up [animation-delay:1000ms] max-md:hidden"
    aria-hidden="true"
  >
    <span class="text-[0.65rem] tracking-[0.15em] text-stone uppercase [writing-mode:vertical-rl]">
      {t.hero.scroll}
    </span>
    <div class="relative h-12 w-px overflow-hidden bg-stone">
      <div class="animate-scroll-line absolute inset-x-0 -top-full h-full bg-champagne"></div>
    </div>
  </div>
</header>
