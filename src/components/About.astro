---
import { t } from '../i18n';
---

<section id="about" class="px-gutter py-section">
  <div
    class="about-grid mx-auto grid max-w-page items-center gap-[clamp(3rem,6vw,6rem)] lg:grid-cols-[1fr_1.2fr]"
  >
    <div class="relative max-w-125 lg:max-w-none">
      <div class="absolute -top-4 -left-4 h-full w-full border border-champagne/30"></div>
      <img
        src="/images/about.jpg"
        alt="Elena Voss"
        class="relative z-1 aspect-3/4 w-full object-cover grayscale-20"
      />
    </div>

    <div>
      <p class="section-label">{t.about.label}</p>
      <h2
        class="about-heading mb-8 font-display text-h2 leading-[1.2] font-light"
        set:html={t.about.heading}
      />
      <div class="about-body">
        {
          t.about.paragraphs.map((paragraph) => (
            <p class="mb-5 max-w-[52ch] text-stone" set:html={paragraph} />
          ))
        }
      </div>

      <div
        class="mt-12 flex gap-12 border-t border-parchment/15 pt-8 max-md:gap-8 max-[480px]:flex-col max-[480px]:gap-6"
      >
        {
          t.about.stats.map((stat) => (
            <div class="about-stat">
              <span class="mb-2 block font-display text-[2.5rem] leading-none font-light text-champagne">
                {stat.value}
              </span>
              <span class="text-sm tracking-[0.02em] text-stone">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
