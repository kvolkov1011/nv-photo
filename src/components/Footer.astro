---
import { tFor } from '../i18n';

const t = tFor(Astro.currentLocale);
---

<footer class="border-t border-parchment/10 px-gutter py-8">
  <div
    class="mx-auto flex max-w-page items-center justify-between max-md:flex-col max-md:gap-6 max-md:text-center"
  >
    <div class="flex items-center gap-6 max-md:flex-col max-md:gap-2">
      <span class="font-display text-[1.1rem] font-normal text-paper">{t.footer.brand}</span>
      <span class="text-sm text-stone">{t.footer.role}</span>
    </div>
    <div class="flex items-center gap-6 max-md:flex-col max-md:gap-2">
      <span class="hidden text-sm text-stone lg:inline">{t.footer.tagline}</span>
      <span class="text-sm text-stone">{t.footer.copyright}</span>
    </div>
    <div>
      <a
        href="#hero"
        class="group flex items-center gap-2 text-[0.75rem] tracking-widest text-stone uppercase transition-colors duration-400 ease-ref hover:text-champagne"
      >
        <span>{t.footer.backToTop}</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.75"
        >
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </a>
    </div>
  </div>
</footer>
