---
import { t } from '../i18n';

const serviceOptions = [
  { value: '', label: t.contact.form.selectPlaceholder },
  ...t.services.items.map((service) => ({ value: service.key, label: service.title })),
  { value: 'other', label: t.contact.form.otherOption },
];
---

<section
  id="contact"
  class="bg-linear-to-b from-midnight to-[#0d0d0e] px-gutter py-section"
>
  <div class="contact-inner mx-auto grid max-w-page gap-[clamp(3rem,6vw,6rem)] lg:grid-cols-2">
    <div>
      <p class="section-label">{t.contact.label}</p>
      <h2
        class="contact-heading mb-12 font-display text-h2 leading-[1.2] font-light"
        set:html={t.contact.heading}
      />

      <div class="contact-details mb-12">
        <div class="mb-6">
          <span
            class="mb-1.5 block text-[0.7rem] font-normal tracking-[0.12em] text-stone uppercase"
          >
            {t.contact.details.email}
          </span>
          <a
            href="mailto:hello@elenavoss.com"
            class="text-base text-parchment transition-colors duration-400 ease-ref hover:text-champagne"
            >hello@elenavoss.com</a
          >
        </div>
        <div class="mb-6">
          <span
            class="mb-1.5 block text-[0.7rem] font-normal tracking-[0.12em] text-stone uppercase"
          >
            {t.contact.details.phone}
          </span>
          <a
            href="tel:+12125551234"
            class="text-base text-parchment transition-colors duration-400 ease-ref hover:text-champagne"
            >+1 (212) 555-1234</a
          >
        </div>
        <div class="mb-6">
          <span
            class="mb-1.5 block text-[0.7rem] font-normal tracking-[0.12em] text-stone uppercase"
          >
            {t.contact.details.studio}
          </span>
          <span class="text-base text-parchment" set:html={t.contact.details.address} />
        </div>
      </div>

      <div class="flex gap-5">
        <a
          href="#"
          class="flex h-10 w-10 items-center justify-center border border-parchment/15 text-stone transition-all duration-400 ease-ref hover:-translate-y-0.5 hover:border-champagne hover:text-champagne"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4.5 w-4.5">
            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
            <circle cx="12" cy="12" r="5"></circle>
            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a
          href="#"
          class="flex h-10 w-10 items-center justify-center border border-parchment/15 text-stone transition-all duration-400 ease-ref hover:-translate-y-0.5 hover:border-champagne hover:text-champagne"
          aria-label="Behance"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4.5 w-4.5">
            <path
              d="M7.5 11c1.38 0 2.5-1.12 2.5-2.5S8.88 6 7.5 6H3v5h4.5zM3 18h5c1.38 0 2.5-1.12 2.5-2.5S9.38 13 8 13H3v5zm10-7h7v-1h-7v1zm3.5 6c-2.49 0-4.5-2.01-4.5-4.5S14.01 8 16.5 8H20v2h-3.5c-1.38 0-2.5 1.12-2.5 2.5s1.12 2.5 2.5 2.5H20v2h-3.5z"
            ></path>
          </svg>
        </a>
        <a
          href="#"
          class="flex h-10 w-10 items-center justify-center border border-parchment/15 text-stone transition-all duration-400 ease-ref hover:-translate-y-0.5 hover:border-champagne hover:text-champagne"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4.5 w-4.5">
            <path
              d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM0 8h5v14H0V8zm7.98 0h4.8v1.9h.07c.67-1.27 2.3-2.6 4.73-2.6 5.06 0 5.99 3.34 5.99 7.69V22h-5v-5.8c0-1.38-.02-3.16-1.93-3.16-1.93 0-2.22 1.51-2.22 3.07V22h-5V8z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div>
      <form
        id="contactForm"
        class="contact-form"
        data-sending={t.contact.form.sending}
        data-sent={t.contact.form.sent}
        data-error={t.contact.form.error}
      >
        <div class="mb-6">
          <label for="name" class="mb-2 block text-[0.7rem] font-normal tracking-[0.12em] text-stone uppercase"
            >{t.contact.form.name}</label
          >
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="w-full border-b border-parchment/20 bg-transparent py-3 text-[0.95rem] leading-[normal] font-light text-paper outline-none transition-colors duration-400 focus:border-champagne"
          />
        </div>
        <div class="mb-6">
          <label for="email" class="mb-2 block text-[0.7rem] font-normal tracking-[0.12em] text-stone uppercase"
            >{t.contact.form.email}</label
          >
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full border-b border-parchment/20 bg-transparent py-3 text-[0.95rem] leading-[normal] font-light text-paper outline-none transition-colors duration-400 focus:border-champagne"
          />
        </div>
        <div class="mb-6">
          <label for="service" class="mb-2 block text-[0.7rem] font-normal tracking-[0.12em] text-stone uppercase"
            >{t.contact.form.service}</label
          >
          <select
            id="service"
            name="service"
            class="form-select w-full border-b border-parchment/20 bg-transparent py-3 text-[0.95rem] leading-[normal] font-light text-paper outline-none transition-colors duration-400 focus:border-champagne"
          >
            {
              serviceOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))
            }
          </select>
        </div>
        <div class="mb-6">
          <label for="message" class="mb-2 block text-[0.7rem] font-normal tracking-[0.12em] text-stone uppercase"
            >{t.contact.form.message}</label
          >
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="min-h-25 w-full resize-y border-b border-parchment/20 bg-transparent py-3 text-[0.95rem] leading-[normal] font-light text-paper outline-none transition-colors duration-400 focus:border-champagne"
          ></textarea>
        </div>

        <div hidden aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button
          type="submit"
          class="form-submit mt-2 cursor-pointer border-none bg-champagne px-12 py-4 text-[0.8rem] leading-[normal] font-normal tracking-[0.12em] text-midnight uppercase transition-all duration-400 ease-ref hover:-translate-y-0.5 hover:bg-paper disabled:cursor-not-allowed disabled:opacity-60"
        >
          {t.contact.form.submit}
        </button>
        <p id="formStatus" class="mt-4 text-sm text-red-400" role="status" hidden></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm');
  const submitBtn = form?.querySelector<HTMLButtonElement>('.form-submit');
  const status = document.getElementById('formStatus');

  if (form instanceof HTMLFormElement && submitBtn && status) {
    const labels = {
      sending: form.dataset.sending ?? '',
      sent: form.dataset.sent ?? '',
      error: form.dataset.error ?? '',
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = labels.sending;
      status.hidden = true;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        if (!res.ok) throw new Error(`Request failed: ${res.status}`);

        submitBtn.textContent = labels.sent;
        form.reset();

        setTimeout(() => {
          submitBtn.textContent = originalLabel;
          submitBtn.disabled = false;
        }, 3000);
      } catch {
        submitBtn.textContent = originalLabel;
        submitBtn.disabled = false;
        status.textContent = labels.error;
        status.hidden = false;
      }
    });
  }
</script>
