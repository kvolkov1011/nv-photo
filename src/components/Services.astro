---
import { t } from '../i18n';

const icons: Record<string, string> = {
  portrait:
    '<circle cx="24" cy="20" r="8"/><path d="M8 42c0-8.837 7.163-16 16-16s16 7.163 16 16"/>',
  nude:
    '<circle cx="24" cy="9" r="5"/><path d="M24 14v14m0 0l-8 14m8-14l8 14M15 21h18"/>',
  projects:
    '<rect x="6" y="6" width="26" height="32" rx="2"/><rect x="16" y="12" width="26" height="32" rx="2"/>',
  diaries:
    '<path d="M4 36l12-14 9 10 6-7 13 11"/><circle cx="34" cy="13" r="5"/><path d="M4 42h40"/>',
};
---

<section
  id="services"
  class="bg-linear-to-b from-midnight to-[#111112] px-gutter py-section"
>
  <div class="mx-auto max-w-page">
    <p class="section-label">{t.services.label}</p>
    <h2 class="services-heading mb-16 font-display text-h2 font-light">
      {t.services.heading}
    </h2>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        t.services.items.map((service) => (
          <article class="service-card group relative border border-parchment/10 px-8 py-10 transition-[border-color,translate] duration-400 ease-ref hover:-translate-y-1 hover:border-champagne/30">
            <span class="absolute top-0 left-0 h-0.5 w-0 bg-champagne transition-[width] duration-400 ease-ref group-hover:w-full" />
            <div
              class="mb-6 h-12 w-12 text-champagne [&>svg]:h-full [&>svg]:w-full"
              aria-hidden="true"
              set:html={`<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">${icons[service.key]}</svg>`}
            />
            <h3 class="mb-4 font-display text-[1.35rem] leading-[1.3] font-normal">
              {service.title}
            </h3>
            <p class="text-[0.9rem] leading-[1.65] text-stone">{service.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
