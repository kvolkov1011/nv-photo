---
const services = [
  {
    title: 'Portrait Photography',
    text: 'Individual and couples sessions crafted to reveal authentic character. Whether in studio or on location, I create an environment where vulnerability becomes the strongest composition.',
    icon: '<circle cx="24" cy="20" r="8"/><path d="M8 42c0-8.837 7.163-16 16-16s16 7.163 16 16"/>',
  },
  {
    title: 'Editorial & Fashion',
    text: "Collaborative work with magazines, brands, and creative directors. Strong visual narratives that respect the publication's voice while pushing aesthetic boundaries.",
    icon: '<rect x="4" y="8" width="40" height="32" rx="2"/><line x1="4" y1="16" x2="44" y2="16"/><line x1="16" y1="8" x2="16" y2="40"/>',
  },
  {
    title: 'Fine Art Projects',
    text: 'Personal and commissioned art photography for collectors, galleries, and exhibitions. Each series explores a concept through sustained visual investigation.',
    icon: '<rect x="6" y="6" width="36" height="36" rx="2"/><circle cx="24" cy="24" r="10"/><circle cx="24" cy="24" r="4"/>',
  },
  {
    title: 'Commercial Campaigns',
    text: 'Brand photography that transcends product shots. I translate brand identity into imagery that connects emotionally and performs commercially across all channels.',
    icon: '<path d="M6 12h36v28a2 2 0 01-2 2H8a2 2 0 01-2-2V12z"/><path d="M16 12V8a4 4 0 014-4h8a4 4 0 014 4v4"/><line x1="6" y1="28" x2="42" y2="28"/>',
  },
];
---

<section
  id="services"
  class="bg-linear-to-b from-midnight to-[#111112] px-[clamp(1.25rem,4vw,3rem)] py-[clamp(5rem,12vw,10rem)]"
>
  <div class="mx-auto max-w-[1240px]">
    <p class="section-label">Services</p>
    <h2 class="services-heading mb-16 font-display text-[clamp(2rem,4vw,3rem)] font-light">
      What I do
    </h2>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <article class="service-card group relative border border-parchment/10 px-8 py-10 transition-[border-color,translate] duration-[400ms] ease-ref hover:-translate-y-1 hover:border-champagne/30">
            <span class="absolute top-0 left-0 h-0.5 w-0 bg-champagne transition-[width] duration-[400ms] ease-ref group-hover:w-full" />
            <div
              class="mb-6 h-12 w-12 text-champagne [&>svg]:h-full [&>svg]:w-full"
              aria-hidden="true"
              set:html={`<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">${service.icon}</svg>`}
            />
            <h3 class="mb-4 font-display text-[1.35rem] leading-[1.3] font-normal">
              {service.title}
            </h3>
            <p class="text-[0.9rem] leading-[1.65] text-stone">{service.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
